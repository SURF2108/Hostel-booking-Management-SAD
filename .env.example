# Server configuration
NODE_ENV=development
PORT=5000

# MongoDB persistence (local replica set recommended for multi-document ACID transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/hostel_booking?replicaSet=rs0
MONGODB_DB_NAME=hostel_booking

# Authentication (generate a 64-char hex secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-secure-random-hex-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=hostel_session

# CORS / Frontend origin
CLIENT_ORIGIN=http://localhost:5173

# Local fictional demo seed password (only used by npm run seed in non-production environments)
SEED_DEMO_PASSWORD=HostelDemo#2026
